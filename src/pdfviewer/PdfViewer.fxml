<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.ScrollPane?>
<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pdfviewer.Controller">
	<padding>
		<Insets bottom="5" left="5" right="5" top="5" />
	</padding>
	<top>
		<HBox spacing="5">
			<Button style="-fx-background-color: blue;" text="Imprimer" textFill="#fcf7f7" />
			<Label text="Zoom:" />
			<Button onAction="#zoomOut" text="-" />
			<Button onAction="#zoomIn" text="+" />
			<Button onAction="#zoomFit" text="Zoom to fit" />
			<Button onAction="#zoomWidth" text="Zoom to width" />
			<Label fx:id="currentZoomLabel" />
			<padding>
				<Insets bottom="5" left="5" right="5" top="5" />
			</padding>
		</HBox>
	</top>
	<center>
		<Pagination fx:id="pagination" />
	</center>
	<fx:define>
		<ScrollPane fx:id="scroller" pannable="true" />
	</fx:define>
</BorderPane>
